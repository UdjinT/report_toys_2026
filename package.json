{
  "name": "report_toys_2026",
  "private": true,
  "version": "0.1.0",
  "description": "PWA and web reporting for toy vending machines with Cloudflare Workers + D1.",
  "scripts": {
    "start": "npm run build:bot && node bot-polling.js",
    "build:bot": "tsc bot-polling.ts --lib es2020 --module commonjs --target es2020 --esModuleInterop",
    "dev": "wrangler dev --port 8787",
    "dev:8788": "wrangler dev",
    "build": "true",
    "publish": "wrangler deploy",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^20.11.7",
    "typescript": "^5.6.0",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.2.0",
    "axios": "^1.19.0",
    "telegraf": "^4.16.3"
  }
}
