FROM node:20-alpine

WORKDIR /app

# Скопируй package.json и установи зависимости
COPY package.json package-lock.json* ./
RUN npm install

# Скопируй исходный код
COPY bot-polling.ts ./

# Компилируй TypeScript
RUN npx tsc bot-polling.ts --lib es2020 --module commonjs --target es2020 --esModuleInterop

# Запусти бота
CMD ["node", "bot-polling.js"]
